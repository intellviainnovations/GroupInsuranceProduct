# Environment variable names the backend reads. Placeholders only.
# ENV selects the run mode: "dev" enables docs and relaxes required settings; anything else
# (or unset) is production.
ENV=prod
APP_CONFIG_FILE=/etc/gip/app.toml
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=<set-in-protected-environment>
APP_THROTTLE_ENABLED=true
APP_THROTTLE_MAX_REQUESTS=120
APP_THROTTLE_WINDOW_SECONDS=60
