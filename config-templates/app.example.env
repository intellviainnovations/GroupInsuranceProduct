# Environment variable names the backend reads. Placeholders only.
# ENV selects the run mode: "dev" enables docs and relaxes required settings; anything else
# (or unset) is production.
ENV=prod
APP_CONFIG_FILE=/etc/gip/app.toml
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=<set-in-protected-environment>
APP_THROTTLE_ENABLED=true
APP_THROTTLE_MAX_REQUESTS=120
APP_THROTTLE_WINDOW_SECONDS=60
# Backend and adapters (docs/design/repositories.md). Unset = sql + unconfigured adapters outside
# dev/demo (fail closed); dev/demo default to memory + fakes. memory/fake are refused otherwise.
APP_DATA_BACKEND=sql
APP_INSURER_ADAPTER=usgic
APP_SESSION_SECRET=<set-in-protected-environment>
APP_ALLOWED_ORIGINS=<https://staff-app.bank.example>
APP_SESSION_COOKIE_SECURE=true
APP_SELECTABLE_ACCOUNT_STATUSES=ACTIVE
APP_ISSUE_RETRY_LIMIT=3
APP_RETRY_DELAY_SECONDS=60
